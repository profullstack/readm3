{
  "name": "@profullstack/readm3",
  "version": "0.25.0",
  "description": "Markdown editing and sharing for people and teams. Web/PWA, CLI, API and MCP with version history, view/edit links, and a terminal reader.",
  "type": "module",
  "license": "MIT",
  "author": "Profullstack, Inc.",
  "engines": {
    "bun": ">=1.1",
    "node": ">=22.6"
  },
  "bin": {
    "readm3": "./bin/readm3.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "start": "bun src/cli.ts",
    "site:build": "bun site/build.ts",
    "site:start": "bun site/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p site/tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:bun": "bun test ./test",
    "prepublishOnly": "npm run build",
    "test:site": "playwright test -c site/playwright.config.ts",
    "test:server": "bun test ./server/test",
    "test:accounts": "bun test ./server/test && playwright test -c site/accounts.playwright.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@profullstack/auth-system": "^0.8.3",
    "@profullstack/cli": "^0.1.0",
    "@profullstack/footer": "latest",
    "@profullstack/hqtui": "^0.11.1",
    "@profullstack/profile": "0.1.6",
    "@profullstack/synconfig": "^0.1.3",
    "@profullstack/x402-gateway": "^0.15.1",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "markdown",
    "reader",
    "editor",
    "gfm",
    "commonmark",
    "viewer",
    "tui",
    "cli",
    "terminal",
    "file-browser",
    "hqtui",
    "bun"
  ],
  "homepage": "https://github.com/profullstack/readm3#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/profullstack/readm3.git"
  },
  "bugs": {
    "url": "https://github.com/profullstack/readm3/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
